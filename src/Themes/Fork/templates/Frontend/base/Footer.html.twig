<footer id="footer" class="mt-auto">
  <div class="container">
    <ul class="nav nav-pills justify-content-center">
      <li class="nav-item"><a class="nav-link" href="{{ url('pages__page__1.' ~ app.request.locale) }}">© <span itemprop="copyrightYear">{{ date().format('Y') }}</span> {{ siteTitle }}</a></li>
      {% for footerLink in footerLinks %}
        <li class="nav-item">
          <a class="nav-link{% if footerLink.link_class is defined and footerLink.link_class %} {{ footerLink.link_class }}{% endif %}" href="{{ footerLink.url }}" title="{{ footerLink.navigation_title }}"{% if footerLink.rel %} rel="{{ footerLink.rel }}"{% endif %}>
            {{ footerLink.navigation_title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</footer>
