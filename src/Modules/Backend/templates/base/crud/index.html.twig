{% extends '@Backend/base/base.html.twig' %}
{% import '@Backend/base/macros.html.twig' as macro %}

{% block actionbar %}
  {% if is_allowed(crudActionName) %}
    <div class="btn-toolbar justify-content-end">
      <div class="btn-group" role="group">
        {{ macro.buttonIcon(action_path(crudActionName), 'plus-square', 'lbl.Add'|trans|ucfirst, 'btn-success') }}
      </div>
    </div>
  {% endif %}
{% endblock %}

{% block content %}
  {{ pageon_datagrid(backend_data_grid) }}
{% endblock %}
