{% include "@Frontend/base/Head.html.twig" %}

<body class="{{ app.request.locale }}" itemscope itemtype="http://schema.org/WebPage">
{# Site wide HTML just after body tag #}
{{ get_module_setting('Frontend', 'site_html_start_of_body', '')|raw }}
{% block navigation %}
  <nav class="navbar navbar-dark bg-black navbar-static-top">
    <div class="container">
      <div class="navbar-header">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar" aria-controls="navbar" aria-expanded="false">
          <span class="navbar-toggler-icon"></span>
          <span class="visually-hidden" data-role="label">{{ 'lbl.OpenNavigation'|trans }}</span>
        </button>

        <a class="navbar-brand" href="{{ url('pages__page__1.' ~ app.request.locale) }}">{{ siteTitle }}</a>
      </div>
      <div id="navbar" class="navbar-collapse collapse">
{#        {{ getnavigation('page', 0, 1) }}#}
        <div class="navbar-right">
          {% include "@Frontend/base/Languages.html.twig" %}
        </div>
      </div>
    </div>
  </nav>
{% endblock %}

<div class="content container">
  {% block breadcrumb %}
    {% include "@Frontend/base/Breadcrumb.html.twig" %}
  {% endblock %}

  {% block pageTitle %}
    {% if not hideContentTitle %}
      <header class="page-header">
        <h1>{{ contentTitle }}</h1>
      </header>
    {% endif %}
  {% endblock %}

  {# Main content #}
  {% block main %}
  {% endblock %}

  {% block privacyConsentDialog %}
    {% include "@Frontend/base/PrivacyConsentDialog.html.twig" %}
  {% endblock %}

  {% block footer %}
    {% include "@Frontend/base/Footer.html.twig" %}
  {% endblock %}
</div>

{# General Javascript #}
{% for js in jsFiles %}
  <script src="{{ js }}"></script>
{% endfor %}

{# Site wide HTML just before closing body tag #}
{{ get_module_setting('Frontend', 'site_html_end_of_body', '')|raw }}
</body>
</html>
