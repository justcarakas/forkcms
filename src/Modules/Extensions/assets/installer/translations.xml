      <item type="error" name="InformationFileCouldNotBeLoaded">
        <translation locale="nl"><![CDATA[Er is een info.xml bestand aanwezig maar we konden deze niet inladen. Controleer of deze een geldige XML syntax heeft.]]></translation>
        <translation locale="en"><![CDATA[A info.xml file is present but it could not be loaded. Verify if the content is valid XML.]]></translation>
        <translation locale="ru"><![CDATA[Файл info.xml присутствует, но не может быть загружен. Проверьте содержимое файла XML.]]></translation>
        <translation locale="es"><![CDATA[Un archivo info.xml está presente pero no se ha podido cargar. Verifica si el contenido es XML válido.]]></translation>
        <translation locale="de"><![CDATA[Eine info.xml Datei ist vorhanden, konnte aber nicht geladen werden. Überprüfe, dass es sich um eine gültige XML Datei handelt.]]></translation>
        <translation locale="hu"><![CDATA[Az info.xml fájl létezik, de nem töltődött be. Ellenőrizd, hogy valid XML e a tartalom.]]></translation>
        <translation locale="sv"><![CDATA[info.xml fil är finns men den kan inte laddas. Verifiera om innehållet är giltig XML.]]></translation>
        <translation locale="zh"><![CDATA[info.xml文件已递交但它无法被加载。请确认它的内容是否是有效的XML。]]></translation>
        <translation locale="el"><![CDATA[Βρέθηκε ένα αρχείο info.xml, αλλά δεν έγινε δυνατό να φορτωθεί. Επιβεβαιώστε οτι το περιεχόμενο είναι έγκυρο τύπου XML.]]></translation>
        <translation locale="pl"><![CDATA[Dostępny jest plik info.xml, ale nie można go załadować. Sprawdź, czy ma poprawną składnię XML.]]></translation>
        <translation locale="pt"><![CDATA[Foi encontrado um ficheiro info.xml, mas não foi possível carregá-lo. Verifique se o ficheiro contem XML válido.]]></translation>
      </item>
      <item type="error" name="InformationFileIsEmpty">
        <translation locale="nl"><![CDATA[Er is een info.xml bestand aanwezig maar deze is leeg of deze bevat geen nuttige informatie.]]></translation>
        <translation locale="en"><![CDATA[A info.xml file is present but its either empty or it does not contain valuable information.]]></translation>
        <translation locale="ru"><![CDATA[Файл info.xml присутствует, но либо пустой, либо содержит неправильную информацию.]]></translation>
        <translation locale="es"><![CDATA[Un archivo info.xml está presente pero esta vacio o bien no contiene información valiosa.]]></translation>
        <translation locale="de"><![CDATA[Eine info.xml Datei ist vorhanden, ist aber entweder leer oder enthält keine brauchbaren Informationen.]]></translation>
        <translation locale="hu"><![CDATA[Az info.xml létezik, de nem üres vagy nem tartalmaz értékes információt.]]></translation>
        <translation locale="sv"><![CDATA[info.xml fil är men är antingen tom eller innehåller den inte värdefull information.]]></translation>
        <translation locale="zh"><![CDATA[info.xml文件已递交但它有可能是空的或它不包含有价值的信息。]]></translation>
        <translation locale="el"><![CDATA[Το αρχείο info.xmp υπάρχει, αλλά είτε είναι άδειο είτε δεν περιέχει χρήσιμες πληροφορίες.]]></translation>
        <translation locale="pl"><![CDATA[Istnieje plik info.xml, ale jest pusty lub nie zawiera użytecznych informacji.]]></translation>
        <translation locale="pt"><![CDATA[Foi encontrado um ficheiro info.xml mas este encontra-se vazio ou não contem informação útil.]]></translation>
      </item>
