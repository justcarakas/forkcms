{
    "name": "forkcms/forkcms",
    "description": "Fork is an open source CMS that will rock your world.",
    "keywords": [
        "cms",
        "fork",
        "fork cms",
        "content management system",
        "symfony",
        "blog",
        "php"
    ],
    "version": "6.0.0",
    "homepage": "https://www.fork-cms.com/",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-spl": "*",
        "ext-simplexml": "*",
        "ext-libxml": "*",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.0",
        "google/recaptcha": "~1.1",
        "jeroendesloovere/geolocation-php-api": "^2.1",
        "liip/imagine-bundle": "^2.5",
        "symfony/monolog-bundle": "^4.0",
        "codex-team/editor.js": "^2.0",
        "beberlei/doctrineextensions": "^1.2",
        "symfony/webpack-encore-bundle": "^2.4.1",
        "phpoffice/phpspreadsheet": "^5.7",
        "symfony/flex": "^2.0",
        "symfony/asset": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/form": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/validator": "^8.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "symfony/twig-bundle": "^8.0",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0",
        "symfony/debug-bundle": "^8.0",
        "symfony/yaml": "^8.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/messenger": "^8.0",
        "beberlei/assert": "^3.3",
        "symfony/rate-limiter": "^8.0",
        "symfony/http-client": "^8.0",
        "pageon/pageon-doctrine-data-grid-bundle": "^0.3.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "symfony/uid": "^8.0",
        "composer/semver": "^3.2",
        "symfony/html-sanitizer": "^8.0",
        "scienta/doctrine-json-functions": "^6.0",
        "twig/intl-extra": "^3.3",
        "symfony/expression-language": "^8.0",
        "symfony/lock": "^8.0",
        "laminas/laminas-feed": "^2.22"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/phpunit-bridge": "^8.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "symfony/var-dumper": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/maker-bundle": "^1.31",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "symfony/stopwatch": "^8.0",
        "symfony/web-profiler-bundle": "^8.0",
        "symfony/browser-kit": "^8.0",
        "friendsoftwig/twigcs": "*",
        "dama/doctrine-test-bundle": "^8.0",
        "symfony/css-selector": "^8.0"
    },
    "config": {
        "bin-dir": "bin",
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "support": {
        "forum": "https://fork-cms.herokuapp.com",
        "issues": "https://github.com/forkcms/forkcms/issues"
    },
    "scripts": {
        "test": "symfony php bin/simple-phpunit",
        "phpstan": "APP_DEBUG=1 symfony console cache:warm -q -edev && symfony php -d memory_limit=-1 bin/phpstan -vvv analyze src -c phpstan.neon",
        "phpcs": "symfony php -d memory_limit=-1 bin/phpcs --standard=PSR12 --extensions=php --warning-severity=9 --exclude=Generic.Files.LineLength --report=full --ignore=*/tests/*,*/*.tpl.php \"src\"",
        "post-install-cmd": [],
        "post-update-cmd": [],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "autoload": {
        "psr-4": {
            "ForkCMS\\": "src"
        },
        "exclude-from-classmap": [
            "**/Tests/",
            "**/tests/",
            "**/Test/"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.*"
        }
    }
}
